// Windows resources: application icon, version information and (MinGW) the manifest.
// RRM_VERSION_MAJOR/MINOR/PATCH come from CMake (see the WIN32 block of CMakeLists.txt).
#include <winver.h>

#ifndef RRM_VERSION_MAJOR
#define RRM_VERSION_MAJOR 0
#endif
#ifndef RRM_VERSION_MINOR
#define RRM_VERSION_MINOR 0
#endif
#ifndef RRM_VERSION_PATCH
#define RRM_VERSION_PATCH 0
#endif
#define RRM_STR2(x) #x
#define RRM_STR(x) RRM_STR2(x)
#define RRM_VERSION_STRING RRM_STR(RRM_VERSION_MAJOR) "." RRM_STR(RRM_VERSION_MINOR) "." RRM_STR(RRM_VERSION_PATCH)

// The first icon in the executable is used by Explorer and by SDL for the window icon.
1 ICON "marathon.ico"

// MSVC embeds the manifest through the linker (it is listed as a source file in CMake);
// GNU windres has no such step, so embed it here as CREATEPROCESS_MANIFEST_RESOURCE_ID.
#if defined(__GNUC__)
1 24 "marathon.manifest"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION RRM_VERSION_MAJOR, RRM_VERSION_MINOR, RRM_VERSION_PATCH, 0
 PRODUCTVERSION RRM_VERSION_MAJOR, RRM_VERSION_MINOR, RRM_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Ridge Racer Marathon contributors"
            VALUE "FileDescription", "Ridge Racer Marathon"
            VALUE "FileVersion", RRM_VERSION_STRING
            VALUE "InternalName", "RidgeRacerMarathon"
            VALUE "LegalCopyright", "Unofficial fan launcher. No game data included."
            VALUE "OriginalFilename", "RidgeRacerMarathon.exe"
            VALUE "ProductName", "Ridge Racer Marathon"
            VALUE "ProductVersion", RRM_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
