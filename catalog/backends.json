      "id": "lr-swanstation",
      "name": "SwanStation (PS1 core)",
      "kind": "libretro",
      "core": "swanstation",
      "license": "GPL-3.0",
      "homepage": "https://github.com/libretro/swanstation",
      "description": "PlayStation emulation inside Marathon: up to 16x internal resolution, PGXP geometry precision and a widescreen hack that widens the 3D view to 16:9, 21:9, 32:9 or your screen's shape (2D HUD elements stretch).",
      "capabilities": {
        "resolution": [
          "native",
          "2x",
          "3x",
          "4x",
          "5x",
          "6x",
          "8x",
          "10x",
          "720p",
          "1080p",
          "1440p",
          "4k",
          "5k",
          "display"
        ],
        "fps": [
          "original",
          "display",
          "60",
          "90",
          "120",
          "144",
          "165",
          "240",
          "300",
          "360",
          "custom"
        ],
        "aspect": [
          "auto",
          "4:3",
          "16:9",
          "21:9",
          "32:9",
          "fit"
        ],
        "redraw": false,
        "precision": true,
        "speed": "base-and-turbo",
        "vsync": true,
        "fullscreen": true,
        "filter": [
          "nearest",
          "linear",
          "xbr"
        ],
        "antiAlias": [
          "off",
          "msaa",
          "ssaa"
        ],
        "fpsMethod": [
          "interpolate",
          "blend"
        ]
      },
      "params": {
        "needsBios": "ps1-optional"
      },
      "sources": {}
    },
