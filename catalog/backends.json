        "vsync": true,
        "fullscreen": true,
        "filter": [
          "nearest",
          "linear"
        ]
      },
      "sources": {
        "windows-x86_64": {
          "kind": "github",
          "repo": "mamedev/mame",
          "asset": "mame*b_x64.exe",
          "archive": "7z",
          "executable": "mame.exe"
        },
        "macos-universal": {
          "kind": "user",
          "executable": "mame",
          "note": "MAME publishes no macOS build: link your own (e.g. Homebrew or SDLMAME)."
